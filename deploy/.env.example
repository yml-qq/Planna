# Planna 运维配置模板。复制为 deploy/.env 并通过 secret manager/CI secrets 注入真实值。
# 任何真实密钥、密码、私钥都不得提交到 git；本文件只保留占位符。
APP_ENV=staging
ASPNETCORE_URLS=http://0.0.0.0:8080

# 数据库（API 与 migrate 工具共用）
PLANNADB_CONNECTION=Host=db.internal;Port=5432;Database=planna;Username=planna;Password=<secret>

# JWT 与认证（JWT_SIGNING_KEY/AUTH_CODE_PEPPER 至少 32 字节）
JWT_ISSUER=https://api.example.com
JWT_AUDIENCE=planna-clients
JWT_SIGNING_KEY=<secret-32-bytes-minimum>
AUTH_CODE_PEPPER=<secret-32-bytes-minimum>
AUTH_OUTBOX_KEY=<base64-32-bytes-secret>
# 仅当经可信反向代理部署时填写；逗号分隔的 IP，禁止域名/*。
AUTH_TRUSTED_PROXIES=

# AI（none 关闭；rule_based 为本地规则实现）
AI_PROVIDER=rule_based
AI_RATE_LIMIT_PER_MINUTE=60

# Worker：邮件投递与隐私清理
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PRIVACY_DELETION_RETENTION_DAYS=30
PRIVACY_CLEANUP_INTERVAL_MINUTES=60
