{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planna.app/spec/focus-report-v1.schema.json",
  "title": "Planna focus report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "from",
    "to",
    "timeZone",
    "totalSessions",
    "completedSessions",
    "abandonedSessions",
    "actualSeconds",
    "days"
  ],
  "properties": {
    "schema_version": {"const": "planna-focus-report-v1"},
    "from": {"type": "string", "format": "date"},
    "to": {"type": "string", "format": "date"},
    "timeZone": {"type": "string", "minLength": 1},
    "totalSessions": {"type": "integer", "minimum": 0},
    "completedSessions": {"type": "integer", "minimum": 0},
    "abandonedSessions": {"type": "integer", "minimum": 0},
    "actualSeconds": {"type": "integer", "minimum": 0},
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "completedSessions", "actualSeconds"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "completedSessions": {"type": "integer", "minimum": 0},
          "actualSeconds": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
